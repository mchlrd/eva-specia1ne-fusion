<?xml version="1.0" encoding="utf-8"?>
<!--
  EvaroTech website — IIS front door for the Node server.

  IIS does three jobs here, and nothing else:
    1. terminates HTTPS (the existing certificate and bindings stay as they are)
    2. redirects plain HTTP to HTTPS
    3. forwards every request to the Node process on 127.0.0.1:3000

  Place this file in the IIS site's physical path — a folder that contains ONLY
  this file. Do NOT point IIS at the application folder: .env.local holds the
  SMTP password and must never be downloadable.

  BEFORE this file will work (run as Administrator, see deploy/SELF-HOSTING.md):
    - URL Rewrite 2.1 and Application Request Routing (ARR) 3.0 installed
    - the forwarded headers below added to the server's allowed list, otherwise
      IIS returns 500.50 instead of proxying
-->
<configuration>
  <system.webServer>

    <!-- ARR proxy. preserveHostHeader keeps Host: evarotech.ca (not 127.0.0.1),
         so links and any absolute URLs generated by the app use the real name. -->
    <proxy enabled="true" preserveHostHeader="true" />

    <rewrite>
      <rules>

        <!-- 1. Plain HTTP is redirected to HTTPS. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- 2. Everything else is served by the Node process. -->
        <rule name="Proxy to Node server" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- REQUIRED: without this the app sees every visitor as 127.0.0.1,
                 and the contact form's per-IP rate limit becomes one shared
                 bucket for the whole internet. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <!-- Tells the app the visitor arrived over HTTPS. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
