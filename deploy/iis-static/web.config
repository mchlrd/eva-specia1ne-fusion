<?xml version="1.0" encoding="utf-8"?>
<!--
  Site configuration for the static deployment of evarotech.ca.

  This file sits in the site root, next to index.html. It does four things:
    1. sends every unknown URL to the site's own 404 page instead of IIS's
    2. keeps .config files (including itself) from ever being downloadable
    3. never shows error details to visitors
    4. caches the hashed build assets for a year

  The contact form needs its mail settings. Put the password in web.config ONLY
  if you prefer it there — setting them as machine environment variables instead
  keeps the password entirely outside the web root:

      EVAROTECH_SMTP_PASS          (and SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_TO)

  See deploy/STATIC-HOSTING.md.
-->
<configuration>

  <appSettings>
    <!-- Environment variables win over these values. Leave SMTP_PASS empty if
         you set EVAROTECH_SMTP_PASS instead. -->
    <add key="SMTP_HOST" value="smtp.office365.com" />
    <add key="SMTP_PORT" value="587" />
    <add key="SMTP_USER" value="no-reply@evarotech.ca" />
    <add key="SMTP_PASS" value="" />
    <add key="SMTP_TO" value="service@evarotech.ca" />
    <add key="LOG_PATH" value="C:\inetpub\logs\evarotech-enquiries.log" />
  </appSettings>

  <system.web>
    <!-- Details only for requests from the server itself; visitors see the
         generic message in the handler. -->
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>

    <!-- Serve the site's own 404 page.

         errorMode="DetailedLocalOnly" is IIS's own default and the safe choice:
         a request from the server itself shows the real error (so this thing can
         be debugged over RDP), while a visitor only ever gets the generic page.
         errorMode="Custom" would hide the reason even on the server, which turns
         every future problem into guesswork. -->
    <httpErrors errorMode="DetailedLocalOnly">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- index.html is the site's only entry point. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- Belt and braces: web.config (and any other .config) must never be
             served as a file.

             The <remove> lines are NOT optional. Both entries already exist in
             IIS's own applicationHost.config, and re-adding an entry whose key
             is already present is a configuration error, not an override: IIS
             answers every request with
                 500.19, Error Code 0x800700b7
                 "Cannot add duplicate collection entry of type 'add'"
             `<remove>` first makes these lines idempotent whether or not the
             server you deploy to still carries the stock defaults. -->
        <hiddenSegments>
          <remove segment="web.config" />
          <add segment="web.config" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".config" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Build assets carry a content hash in their filename, so they can be cached
       for as long as we like. Scoped to /assets so HTML is always re-validated —
       otherwise a redeploy would keep serving the old pages. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
