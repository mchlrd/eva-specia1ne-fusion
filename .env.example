# SMTP (Office 365) — used by the contact form, server-side only.
# Copy to .env.local locally; set the same keys in Vercel → Settings → Environment Variables.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@evarotech.ca
SMTP_PASS=
# Where enquiries are delivered (defaults to service@evarotech.ca if unset)
SMTP_TO=service@evarotech.ca